[Desktop Entry]
Version=1.0
Type=Application
Name=Rustle
GenericName=Music Player
Comment=Stream NetEase Cloud Music and play your local library
Exec=rustle %U
Icon=life.fxs.rustle
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;player;audio;netease;lyrics;
StartupNotify=true
StartupWMClass=life.fxs.rustle
MimeType=x-scheme-handler/rustle;audio/mpeg;audio/mp3;audio/x-mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/wav;audio/x-wav;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/aiff;audio/x-aiff;
