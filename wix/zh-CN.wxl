<?xml version="1.0" encoding="utf-8"?>
<WixLocalization xmlns="http://schemas.microsoft.com/wix/2006/localization" Culture="zh-cn" Codepage="936">
    <String Id="ProductName">Rustle</String>
    <String Id="Manufacturer">Fei Xiangshi</String>
    <String Id="PackageDescription">Rustle 音乐播放器</String>
    <String Id="AudioFileTypeName">Rustle 音频文件</String>
    <String Id="InstallOptionsDialogTitle">安装选项</String>
    <String Id="InstallOptionsTitle">选择安装选项</String>
    <String Id="InstallOptionsDescription">你可以选择是否创建快捷方式。两个选项默认关闭，之后仍可在 Windows 中手动调整。</String>
    <String Id="CreateDesktopShortcut">创建桌面快捷方式</String>
    <String Id="StartWithWindows">登录 Windows 时自动启动 Rustle</String>
    <String Id="RemoveRustleDataDialogTitle">删除 Rustle 数据</String>
    <String Id="RemoveRustleDataTitle">删除 Rustle 数据？</String>
    <String Id="RemoveRustleDataDescription">Rustle 默认会保留设置、歌单、登录状态和缓存。只有在你主动选择下面的选项时，才会删除 Rustle 自有数据。已下载音乐、导入的音乐和本地歌单中的文件不会被删除。</String>
    <String Id="RemoveRustleDataCheckBox">删除 Rustle 设置、数据库、登录数据、缓存和临时文件</String>
    <String Id="RemoveRustleDataRemove">删除</String>
</WixLocalization>
